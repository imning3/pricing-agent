# ===== 服务 =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8600
# 静态鉴权 token；留空则不校验
AGENT_API_TOKEN=
# 任务数据库路径
AGENT_DB_PATH=data/tasks.db
# asyncio worker 并发数
AGENT_WORKERS=4
# 终态任务保留时长（小时）
AGENT_TASK_TTL_HOURS=24

# ===== LLM =====
# mock | litellm
LLM_BACKEND=litellm
# 模型写法（litellm 路由，按供应商加前缀）：
#   OpenAI 兼容（在线 API / vLLM / Ollama / 中转站）：
#     LLM_MODEL=openai/gpt-4o-mini   LLM_BASE_URL=https://...   LLM_API_KEY=sk-...
#   Anthropic 直连：
#     LLM_MODEL=anthropic/claude-sonnet-4-5   LLM_API_KEY=sk-ant-...   （LLM_BASE_URL 留空）
#   Anthropic 经 OpenAI 兼容中转：
#     LLM_MODEL=openai/claude-sonnet-4-5   LLM_BASE_URL=中转地址   LLM_API_KEY=中转密钥
# ★ LLM_BASE_URL 不要以 / 结尾：尾部斜杠会使 anthropic 前缀路由拼出 //v1/messages 而被网关 404
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# 大文档多段抽取较慢，生产建议 1200；开发联调可改小
LLM_TIMEOUT_SECONDS=1200
# 单次补全的输出上限：网关普遍要求显式传值（本网关校验 [1, 65536]，缺省报 InvalidParameter）
LLM_MAX_TOKENS=65536
# 分段抽取并发：网关有限速/超载时调低
LLM_CONCURRENCY=6
# 离线环境必开：litellm 直接用内置价格表，跳过对外网 raw.githubusercontent.com 的拉取重试
LITELLM_LOCAL_MODEL_COST_MAP=True

# ===== 文件 =====
# 单文件下载上限（MB）
AGENT_MAX_FILE_MB=1024
